-- in this file you can list the queries of interest, any lines that are
-- comments have to begin with '--' at the very start of the line.
-- each query must end in a ';'
-- in the below queries the value of property field1 is meant to be provided by
-- the caller via a bind param field1_param and some of the queries require
-- additional params field1_param2, field1_param3, these must correspond to
-- the first three records inserted in peach.data

SELECT * FROM  testkeyspace.test_table1;
SELECT mapfield, listfield, setfield FROM  testkeyspace.test_table1;
SELECT mapfield['k1'], setfield FROM  testkeyspace.test_table1;
SELECT mapfield['k1' RANGE 'k2'], setfield FROM  testkeyspace.test_table1;
SELECT mapfield['k2'], listfield FROM  testkeyspace.test_table1;
SELECT count(*), avg(field3), sum(field3), min(field3), max(field3)  FROM  testkeyspace.test_table1;
SELECT count(*), avg(field3), sum(field3), min(field3), max(field3)  FROM  testkeyspace.test_table1 GROUP BY field1;
SELECT * FROM  testkeyspace.test_table1 GROUP BY field1;
