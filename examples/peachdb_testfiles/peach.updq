UPDATE testkeyspace.test_table1 SET mapfield = mapfield + {'k1': 'todo', 'k2': 'when'} WHERE field1 = :field1_param AND field2 = 'def' AND field3 = 30 AND field4 = '10:03:43';
UPDATE testkeyspace.test_table1 SET mapfield = mapfield + {'k3': 'todo', 'k4': 'when'} WHERE field1 = :field1_param AND field2 = 'def' AND field3 = 30 AND field4 = '10:03:43';
DELETE mapfield['k1'] FROM testkeyspace.test_table1 WHERE field1 = :field1_param AND field2 = 'def' AND field3 = 30 AND field4 = '10:03:43' IF EXISTS;
