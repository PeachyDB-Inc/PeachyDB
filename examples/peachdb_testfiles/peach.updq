-- in this file you can list the queries of interest, any lines that are
-- comments have to begin with '--' at the very start of the line.
-- each query must end in a ';'
-- in the below queries the value of property field1 is meant to be provided by
-- the caller via a bind param field1_param, the caller must set this value to
-- the one for the first record inserted in peach.data

UPDATE testkeyspace.test_table1 SET listfield = ['todo', 'when'] + listfield WHERE field1 = :field1_param AND field2 = 'def';
UPDATE testkeyspace.test_table1 SET listfield = listfield + ['todo', 'when'] WHERE field1 = :field1_param AND field2 = 'def';
DELETE FROM testkeyspace.test_table1 WHERE field1 = :field1_param AND field2 = 'def' AND field3 = 30 AND field4 = '10:03:43';
INSERT INTO testkeyspace.test_table1
(field1, field2, field3, field4, field5, field6, listfield)
VALUES (:field1_param, 'def', 30, '10:03:43', '10.0.0.2', '10.0.0.2', ['hihi', 'what the', 'heck']);
